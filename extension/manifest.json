{
  "manifest_version": 3,
  "name": "Spoilaint: spoiler-free subtitles",
  "short_name": "Spoilaint",
  "version": "0.8.1",
  "description": "Subtitles that keep up, never run ahead: words appear as they're spoken. Netflix, YouTube, Hotstar, SonyLIV and more.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "sync-speech": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Sync subtitles to speech on this tab (or stop)"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_title": "Spoilaint",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "engine.js",
        "overlay.js",
        "listen.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}